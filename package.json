{
  "name": "m4u-dating",
  "version": "1.0.0",
  "description": "M4U (Made for Each Other) dating app",
  "private": true,
  "scripts": {
    "icons": "capacitor-assets generate --iconBackgroundColor '#ff2d6f' --splashBackgroundColor '#ff2d6f'",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0"
  }
}
